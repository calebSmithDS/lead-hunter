generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PhoneStatus {
  PENDING
  VERIFIED_MOBILE
  LANDLINE_ONLY
  UNAVAILABLE
}

model Job {
  id           String   @id @default(cuid())
  outscraperId String   @unique // The job ID Outscraper returns — used to match the webhook callback
  status       String   @default("Running") // Running, Done, Failed
  keyword      String
  location     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id                  String      @id @default(cuid())
  name                String
  phone               String?
  suburb              String
  reviewCount         Int
  website             String?     // Will hold website or Facebook link or null
  placeId             String      @unique // Google's unique ID for deduplication
  status              String      @default("Uncontacted") // CRM status: Uncontacted, Left Voicemail, etc.

  // Mobile Enrichment (Specification 2.1)
  mobileNumber        String?
  phoneStatus         PhoneStatus @default(PENDING)
  phoneSource         String?     // 'OUTSCRAPER' | 'SCRAPE'

  // Owner Name Enrichment
  ownerName           String?
  ownerConfidence     String?     // 'HIGH' | 'MEDIUM' | 'LOW'

  // PageSpeed Audit (Specification 2.2)
  psiPerformanceScore Int?
  psiSeoScore         Int?
  psiAccessibility    Int?
  psiBestPractices    Int?
  psiLcpMs            Int?
  mobileScreenshot    String?     @db.Text

  // Stack Enrichment (Specification 2.3)
  techStackCms        String?

  // Pipeline Observability (Specification 3 & 4)
  auditStatus         String      @default("PENDING") // PENDING, SUCCESS, PARTIAL_FAIL, FAILED, SKIPPED
  auditErrorLog       Json?       // Stores specific service failures e.g., { "pagespeed": "Timeout", "wappalyzer": "Unreachable" }

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
}
